{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/terms", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "functions": {
    "api/youtube/download.js": {
      "maxDuration": 60,
      "memory": 1769,
      "outputFileTracingIncludes": {
        "api/youtube/download.js": ["./node_modules/ffmpeg-static/ffmpeg"]
      }
    },
    "api/stream.js": {
      "maxDuration": 60
    },
    "api/youtube/info.js": {
      "maxDuration": 30
    }
  }
}
